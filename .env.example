# Application environment: development | production
APP_ENV=development

# Required in production: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Database: leave unset locally for SQLite, or set MySQL URL.
# Docker Compose overrides DATABASE_URL automatically using the MYSQL_* variables below.
# DATABASE_URL=mysql+pymysql://studybuddy:your_password@localhost:3306/studybuddy
MYSQL_DATABASE=studybuddy
MYSQL_USER=studybuddy
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Optional: enables AI-generated tutoring responses via Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Production & Gunicorn settings
FLASK_DEBUG=0
PORT=5000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
LOG_LEVEL=INFO
TRUST_PROXY=1
# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0

