# Application environment: development | production
APP_ENV=development

# Required in production: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Database:
# - Leave DATABASE_URL unset locally for SQLite.
# - For Supabase (recommended persistent PostgreSQL):
#   Copy the URI from Supabase -> Project Settings -> Database -> Connection string (Pooler, port 6543 or 5432).
#   Example:
#   DATABASE_URL=postgresql://postgres.yourprojectref:your_password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# - For local MySQL via Docker (--profile local-db), leave DATABASE_URL unset and set MYSQL_* below.
# DATABASE_URL=
MYSQL_DATABASE=studybuddy
MYSQL_USER=studybuddy
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Optional: enables AI-generated tutoring responses via Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Production & Gunicorn settings
FLASK_DEBUG=0
PORT=5000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
LOG_LEVEL=INFO
TRUST_PROXY=1
# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0

