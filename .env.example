# For local demo, leave DATABASE_URL unset to use SQLite.
# MySQL example:
# DATABASE_URL=mysql+pymysql://studybuddy:your_password@localhost:3306/studybuddy
SECRET_KEY=replace-with-a-long-random-secret
# Optional: enables AI-generated tutoring responses via Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FLASK_DEBUG=0
